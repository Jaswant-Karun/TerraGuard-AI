# ==============================================================================
# TerraGuard AI — Monorepo Master Environment Template
# ==============================================================================

# --- Frontend (Vercel) ---
NEXT_PUBLIC_API_URL=https://terraguard-api.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://terraguard-api.onrender.com/api/v1
NEXT_PUBLIC_MAP_TILE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
NEXT_PUBLIC_DEFAULT_LAT=12.9716
NEXT_PUBLIC_DEFAULT_LNG=77.5946

# --- Backend (Render / Cloud Web Service) ---
PROJECT_NAME="TerraGuard AI Backend"
ENVIRONMENT="production"
DEBUG=False
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000
API_V1_STR="/api/v1"

# MongoDB Atlas
MONGODB_URI="mongodb+srv://terraguard_admin:<STRONG_PASSWORD>@cluster0.abcde.mongodb.net/terraguard?retryWrites=true&w=majority"
DATABASE_NAME="terraguard"

# Security & Authentication
JWT_SECRET="generate-a-cryptographically-secure-64-character-jwt-secret-key-here"
JWT_SECRET_KEY="generate-a-cryptographically-secure-64-character-jwt-secret-key-here"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google Gemini API
GEMINI_API_KEY="AIzaSyYourProductionGeminiApiKeyGoesHere"

# Cloudinary Media
CLOUDINARY_CLOUD_NAME="terraguard"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="your-production-cloudinary-api-secret"
CLOUDINARY_URL="cloudinary://123456789012345:your-production-cloudinary-api-secret@terraguard"

# n8n Automation Engine Webhook Integration
N8N_WEBHOOK_URL="https://terraguard-n8n.onrender.com/webhook"
N8N_WEBHOOK_SECRET="generate-a-strong-random-n8n-webhook-secret-here"

# CORS
ALLOWED_ORIGINS="https://terraguard.vercel.app,https://terraguard-web.vercel.app,http://localhost:3000"
CORS_ORIGINS=["https://terraguard.vercel.app","https://terraguard-web.vercel.app","http://localhost:3000"]

# --- n8n Service Configuration ---
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=dpg-xxxxxxxxxxxx-a.oregon-postgres.render.com
DB_POSTGRESDB_DATABASE=terraguard_n8n
DB_POSTGRESDB_USER=terraguard_user
DB_POSTGRESDB_PASSWORD=your_secure_postgres_password_here
DB_POSTGRESDB_PORT=5432
N8N_ENCRYPTION_KEY=generate-a-strong-random-32-byte-hex-encryption-key-here
N8N_HOST=terraguard-n8n.onrender.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://terraguard-n8n.onrender.com/
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
