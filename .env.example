# ==============================================================================
# TerraGuard AI — Root Monorepo Environment Template
# Duplicate this file to .env in respective app folders during local development
# ==============================================================================

# --- Backend Configuration ---
PROJECT_NAME="TerraGuard AI Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://terraguard.vercel.app"]

# --- Database (MongoDB Atlas) ---
MONGODB_URI="mongodb+srv://<USER>:<PASSWORD>@cluster.mongodb.net/terraguard?retryWrites=true&w=majority"
DATABASE_NAME="terraguard"

# --- AI & Vision ---
GEMINI_API_KEY=""

# --- Cloudinary Media ---
CLOUDINARY_URL=""

# --- n8n Webhook Secret & Endpoint ---
N8N_WEBHOOK_URL="http://localhost:5678/webhook"
N8N_WEBHOOK_SECRET="tg_dev_secret_key"

# --- Frontend Configuration ---
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_MAP_TILE_URL="https://basemaps.cartocdn.com/gl/positron-gl-style/style.json"
NEXT_PUBLIC_DEFAULT_LAT="12.9716"
NEXT_PUBLIC_DEFAULT_LNG="77.5946"

