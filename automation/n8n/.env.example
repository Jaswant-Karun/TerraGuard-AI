# ==============================================================================
# TerraGuard AI — n8n Automation Engine Production Template (Render / Docker)
# ==============================================================================

# Database Backend (PostgreSQL on Render / Supabase / Neon)
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=dpg-xxxxxxxxxxxx-a.oregon-postgres.render.com
DB_POSTGRESDB_DATABASE=terraguard_n8n
DB_POSTGRESDB_USER=terraguard_user
DB_POSTGRESDB_PASSWORD=your_secure_postgres_password_here
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_SCHEMA=public

# Core Encryption Key (Must be kept secure to decrypt stored credentials & workflows)
N8N_ENCRYPTION_KEY=generate-a-strong-random-32-byte-hex-encryption-key-here

# Host & Webhook URL Configuration
N8N_HOST=terraguard-n8n.onrender.com
N8N_PORT=5678
N8N_PROTOCOL=https
WEBHOOK_URL=https://terraguard-n8n.onrender.com/

# Security Settings
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_DISABLE_PRODUCTION_MAIN_PROCESS=false
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
GENERIC_TIMEZONE=Asia/Kolkata

# TerraGuard Webhook Authentication
N8N_WEBHOOK_SECRET=generate-a-strong-random-n8n-webhook-secret-here
TERRAGUARD_BACKEND_URL=https://terraguard-api.onrender.com/api/v1

