# ==============================================================================
# TerraGuard AI — Web Frontend Environment Template (Vercel / Local)
# ==============================================================================

# Public API Gateway URL pointing to the deployed FastAPI backend
# In Production on Vercel: set to your Render backend URL (e.g. https://terraguard-api.onrender.com/api/v1)
NEXT_PUBLIC_API_URL=https://terraguard-api.onrender.com/api/v1
NEXT_PUBLIC_API_BASE_URL=https://terraguard-api.onrender.com/api/v1

# MapLibre Vector Tile Style URL
NEXT_PUBLIC_MAP_TILE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json

# Default Geospatial Focus Coordinates (Bengaluru Metropolitan Region)
NEXT_PUBLIC_DEFAULT_LAT=12.9716
NEXT_PUBLIC_DEFAULT_LNG=77.5946

# Application Metadata
NEXT_PUBLIC_APP_NAME="TerraGuard AI"
