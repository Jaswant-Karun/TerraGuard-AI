# TerraGuard AI — Backend Environment Configuration Example
PROJECT_NAME="TerraGuard AI Backend"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://terraguard.vercel.app"]

# MongoDB Atlas Database URI (Phase 2)
MONGODB_URI="mongodb+srv://<USER>:<PASSWORD>@cluster.mongodb.net/terraguard?retryWrites=true&w=majority"
DATABASE_NAME="terraguard"

# Google Gemini API Key (Phase 4)
GEMINI_API_KEY=""

# Cloudinary Media Storage
CLOUDINARY_URL=""

# n8n Automation Engine Webhooks (Phase 5)
N8N_WEBHOOK_URL="http://localhost:5678/webhook"
N8N_WEBHOOK_SECRET="tg_dev_secret_key"

# JWT Authentication
JWT_SECRET_KEY="dev-insecure-secret-key-change-in-production-0123456789"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

